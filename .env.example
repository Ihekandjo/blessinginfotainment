# ─────────────────────────────────────────────────────────────
# Blessing Infotainment — environment variables
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Web3Forms access key
# Sign up (free) at https://web3forms.com — use your dedicated inbox email.
# Your key appears on the dashboard after sign-up.
VITE_WEB3FORMS_ACCESS_KEY=

# Dedicated inbox that receives contact-form submissions
# Must match the email you registered with on web3forms.com
VITE_CONTACT_EMAIL=info@blessinginfotainment.com
